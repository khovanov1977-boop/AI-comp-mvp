DATABASE_URL=postgresql+psycopg://ai_companion:ai_companion@localhost:5432/ai_companion
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Mock LLM provider, used by default.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500
# OpenRouter appearance-translation fallbacks after LLM_MODEL.
IMAGE_PROMPT_MODELS=qwen/qwen3-30b-a3b-instruct-2507,sao10k/l3-lunaris-8b

# Speech-to-text through Venice. The legacy OpenRouter provider may still use
# STT_BASE_URL/STT_API_KEY, falling back to LLM_BASE_URL/LLM_API_KEY.
STT_PROVIDER=venice
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=openai/whisper-large-v3
STT_TIMEOUT_SECONDS=90

# Text-to-speech through Venice. It uses MP3; legacy TTS_* URL/key/format
# settings apply only when TTS_PROVIDER=openrouter.
TTS_PROVIDER=venice
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=google/gemini-3.1-flash-tts-preview
TTS_TIMEOUT_SECONDS=180
TTS_RESPONSE_FORMAT=mp3
TTS_PCM_SAMPLE_RATE_HZ=24000

# Images: Venice Grok creates the base appearance; Qwen Edit handles in-chat context photos.
# Legacy OpenRouter and hybrid modes remain available for existing jobs.
# An empty IMAGE_API_KEY reuses LLM_API_KEY only for OpenRouter. Keys stay server-side.
# Free-text appearance fields are normalized to English through the configured LLM before image generation.
IMAGE_PROVIDER=disabled
IMAGE_BASE_URL=https://openrouter.ai/api/v1
IMAGE_API_KEY=
IMAGE_MODEL=black-forest-labs/flux.2-pro
GROK_IMAGE_MODEL=x-ai/grok-imagine-image-2.0
IMAGE_TIMEOUT_SECONDS=180
VENICE_API_KEY=
VENICE_LLM_MODEL=gemma-4-uncensored
VENICE_LLM_FALLBACK_MODELS=venice-uncensored-1-2,venice-uncensored-role-play
VENICE_STT_MODEL=openai/whisper-large-v3
VENICE_TTS_MODEL=tts-gemini-3-1-flash
VENICE_IMAGE_MODEL=grok-imagine-image-2-0
VENICE_IMAGE_EDIT_MODEL=grok-imagine-image-2-0-edit
VENICE_SCENE_IMAGE_EDIT_MODEL=qwen-edit-uncensored
VENICE_VIDEO_I2V_MODEL=wan-3-0-reference-to-video
VENICE_VIDEO_R2V_MODEL=wan-3-0-reference-to-video

# Venice chat and speech. LLM_BASE_URL/LLM_API_KEY remain available for legacy
# OpenRouter speech if explicitly selected.
# LLM_PROVIDER=venice
# VENICE_API_KEY=your_venice_key
# VENICE_LLM_MODEL=gemma-4-uncensored
# VENICE_LLM_FALLBACK_MODELS=venice-uncensored-1-2,venice-uncensored-role-play

# Legacy OpenRouter chat baseline:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=mistralai/mistral-small-2603
# LLM_API_KEY=your_openrouter_key
# LLM_TEMPERATURE=0.3

# Local Ollama / OpenAI-compatible endpoint example:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=your_local_model
# LLM_API_KEY=ollama

# Cloud GPU OpenAI-compatible endpoint example:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-endpoint.example.com/v1
# LLM_MODEL=your_cloud_model
# LLM_API_KEY=your_key

POSTGRES_DB=ai_companion
POSTGRES_USER=ai_companion
POSTGRES_PASSWORD=ai_companion
