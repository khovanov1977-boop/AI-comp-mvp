# Copy to .env.production on the VPS. Never commit the filled file.
# Use only letters and digits for the password: it is inserted into DATABASE_URL.
POSTGRES_PASSWORD=
VENICE_API_KEY=

# Site-wide paid request caps, in addition to the per-account limits in code.
# Set explicit nonnegative integers before starting the API. Zero disables the action.
BETA_MAX_IMAGE_OUTPUTS=
BETA_MAX_VIDEO_REQUESTS=

# Optional model overrides. Unset values use the current application defaults.
VENICE_LLM_MODEL=gemma-4-uncensored
VENICE_LLM_FALLBACK_MODELS=venice-uncensored-1-2,venice-uncensored-role-play
VENICE_STT_MODEL=openai/whisper-large-v3
VENICE_TTS_MODEL=tts-gemini-3-1-flash
VENICE_IMAGE_MODEL=grok-imagine-image-2-0
VENICE_IMAGE_EDIT_MODEL=grok-imagine-image-2-0-edit
VENICE_CLOTHING_IMAGE_EDIT_MODEL=qwen-edit-uncensored
VENICE_SCENE_IMAGE_EDIT_MODEL=qwen-edit-uncensored
VENICE_VIDEO_I2V_MODEL=wan-3-0-reference-to-video
VENICE_VIDEO_R2V_MODEL=wan-3-0-reference-to-video
